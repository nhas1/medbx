// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Visitor {
  id             Int      @id @default(autoincrement())
  fullName       String
  email          String?  @unique
  phone          String
  country        String
  city           String?
  role           String?
  specialty      String?
  jobTitle       String?
  sectors        Json
  reasons        Json
  days           Json
  source         String?
  cvUrl          String?
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model SponsorLead {
  id          Int      @id @default(autoincrement())
  company     String
  industry    String
  size        String?
  country     String
  contactName String
  email       String?
  phone       String
  tier        String?
  goals       Json
  needsBooth  Boolean  @default(false)
  notes       String?  @db.Text
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model News {
  id            Int       @id @default(autoincrement())
  titleAr       String
  titleEn       String
  summaryAr     String?   @db.Text
  summaryEn     String?   @db.Text
  coverImageUrl String?
  type          String    @default("news")
  status        String    @default("draft")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
}
